# Site settings of one FPGA SIM deployment (decision 173). The repository holds no host names:
# copy this file to ~/.config/fpgasim/site.env (or set FPGASIM_SITE_ENV to another path) and fill it in.
# The Makefile and the scripts in deploy/ read it. Format: KEY=value, no quotes, no spaces around "=".

# Public address of the interface (Cloudflare Pages). The build server allows it in CORS; make e2e-prod opens it.
FPGASIM_WEB_URL=https://sim.example.org
# Public address of the build server (nginx in front of the service). The interface build talks to it.
FPGASIM_BUILD_URL=https://build.example.org
# SSH host of the VPS (an alias from ~/.ssh/config).
VPS=build-vps
# Cloudflare Pages project of the interface.
FPGASIM_PAGES_PROJECT=fpga-sim
# Cloudflare R2 bucket for the off-site copy of the accounts database (deploy/offsite-r2.sh); empty: no copy.
FPGASIM_BACKUP_BUCKET=
