# Vhost of the system nginx on the VPS for the FPGA SIM build server.
# The owner installs it (root needed): /etc/nginx/sites-available/build.example.org
# and a link in sites-enabled, then nginx -t and reload. The steps are in docs/deploy-server.md.
#
# TLS: like the other sites on this host, a Cloudflare Origin certificate and a DNS record
# in Proxied mode. The other variant (DNS-only record and Let's Encrypt) is described in the same place.
server {
    listen 80;
    listen [::]:80;
    server_name build.example.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name build.example.org;

    ssl_certificate /etc/ssl/cloudflare/build.example.org.pem;
    ssl_certificate_key /etc/ssl/cloudflare/build.example.org.key;

    # A project of up to 2 MB in JSON can take up to 13 MB; above its own limit the service itself answers 413.
    client_max_body_size 16m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_vary on;
    gzip_proxied any;
    gzip_types application/json application/wasm text/javascript application/javascript;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        # A build takes up to 60 s and can wait in the queue for up to 60 s.
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
    }
}
