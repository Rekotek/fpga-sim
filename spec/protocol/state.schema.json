{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol/state.schema.json",
  "title": "Сообщение state: смена состояния симуляции",
  "type": "object",
  "required": [
    "t",
    "run",
    "time",
    "cycle",
    "speed"
  ],
  "additionalProperties": false,
  "properties": {
    "t": {
      "const": "state"
    },
    "run": {
      "enum": [
        "idle",
        "running",
        "paused",
        "finished"
      ]
    },
    "time": {
      "$ref": "common.schema.json#/$defs/timePs"
    },
    "cycle": {
      "type": "integer",
      "minimum": 0
    },
    "speed": {
      "$ref": "common.schema.json#/$defs/speed"
    }
  }
}
