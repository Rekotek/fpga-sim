{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol/error.schema.json",
  "title": "Сообщение error: отказ команды или сбой ядра",
  "type": "object",
  "required": [
    "t",
    "code",
    "text"
  ],
  "additionalProperties": false,
  "properties": {
    "t": {
      "const": "error"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "code": {
      "$ref": "common.schema.json#/$defs/code"
    },
    "text": {
      "type": "string"
    },
    "args": {
      "description": "Для интерфейса: reason выбирает строку словаря, остальные поля подставляются в неё (решение 183). Отказы, которые вызывает только дефект интерфейса, идут без args.",
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z]*$"
        }
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    }
  }
}
