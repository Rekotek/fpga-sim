# Image of the FPGA SIM build service (spec section 8.1): FastAPI under Uvicorn and a Docker client.
# The service does not run foreign code itself: jobs run in one-shot containers of the fpgasim-build image.
# Built from the repository root. Target api is the runtime image; target test is the same with test tools.
FROM python:3.12-slim AS api

COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    PATH=/app/server/.venv/bin:${PATH} \
    PYTHONUNBUFFERED=1 \
    FPGASIM_SHARE=/app

WORKDIR /app/server
COPY server/pyproject.toml server/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY server/fpgasim_server ./fpgasim_server
RUN uv sync --frozen --no-dev
# The board files, the fpgasim.json schema and the Gowin primitive list are needed to parse a project.
COPY boards /app/boards
COPY spec/fpgasim.schema.json spec/gowin-primitives.txt /app/spec/

EXPOSE 8080
CMD ["uvicorn", "--factory", "fpgasim_server.api:create_app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]

FROM api AS test
RUN uv sync --frozen
